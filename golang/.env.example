# Which model provider to use by default (see model-provider.js).
# One of: anthropic, openai, gemini, ollama. Defaults to "anthropic".
MODEL_PROVIDER=anthropic

# -- Anthropic (active by default) --
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# -- OpenAI, needed if MODEL_PROVIDER=openai, AND needed for embeddings
# in the Go and Rust rag examples specifically, regardless of your
# MODEL_PROVIDER, since there is no official Chroma SDK for those two
# languages, and embeddings there go through OpenAI's embeddings API --
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4.1

# -- Gemini, only needed if MODEL_PROVIDER=gemini --
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.6-flash

# -- Ollama, only needed if MODEL_PROVIDER=ollama, no API key required --
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# -- Shared --
# MAX_TOKENS=1024

# -- Avalanche / ChainKit --
# Free key from avacloud.io, required for chainkit-fetch.js and chainkit-mcp-agent.js
GLACIER_API_KEY=your-glacier-key-here

# Start it with: npx -y @avalanche-sdk/chainkit start --transport sse --port 2718
# (the CLI only offers stdio/sse transports, no streamable-http, and no
# `mcp-server` subcommand, verified against the published 0.3.13 package)
CHAINKIT_MCP_URL=http://localhost:2718/sse

# A Fuji wallet address to query in the examples, yours or any public one
WALLET_ADDRESS=0xYourFujiWalletAddressHere

# -- Chroma / RAG (Session 5) --
# Where to reach Chroma. Leave these as the defaults for local
# development (after "docker run -p 8000:8000 chromadb/chroma" or
# "chroma run"). If you're running this app itself inside Docker
# Compose, set CHROMA_HOST=chroma instead, docker-compose.yml already
# does this for you automatically, you don't need to edit it by hand.
CHROMA_HOST=localhost
CHROMA_PORT=8000

# -- Payment Agent (Session 6) --
# The wallet the agent signs transactions with. Use a Fuji TESTNET-ONLY
# key you generated for this cohort, never a real mainnet key, and never
# commit this file with a real value filled in.
AGENT_PRIVATE_KEY=your-fuji-testnet-private-key-here

# USDC's contract address on Fuji, look this up on Snowtrace's testnet
# explorer if you don't already have it.
FUJI_USDC_ADDRESS=0xYourFujiUSDCContractAddressHere

# Safety pillar: spending limit, in USDC, per transaction. The agent
# refuses to send anything above this, no exceptions, checked in
# preflightChecks before every payment.
MAX_PAYMENT_USDC=500
